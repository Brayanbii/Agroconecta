{
  "info": {
    "name": "AgroConecta API",
    "description": "Colección de endpoints REST de AgroConecta\n\nBase URL: https://agroconecta-04uf.onrender.com\nDomino: https://agroconecta.farm\n\nCredenciales de prueba:\n- Admin: admin@agroconecta.com / 123\n- Campesino: pepe@finca.com / 123\n- Cliente: maria@gmail.com / 123\n- Repartidor: repartidor@agroconecta.com / 123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://agroconecta-04uf.onrender.com" },
    { "key": "admin_email", "value": "admin@agroconecta.com" },
    { "key": "admin_pass", "value": "123" },
    { "key": "cliente_email", "value": "maria@gmail.com" },
    { "key": "cliente_pass", "value": "123" },
    { "key": "campesino_email", "value": "pepe@finca.com" },
    { "key": "campesino_pass", "value": "123" }
  ],
  "item": [
    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@agroconecta.com\",\n  \"password\": \"123\"\n}" },
            "url": { "raw": "{{base_url}}/api/usuarios/login", "host": ["{{base_url}}"], "path": ["api", "usuarios", "login"] }
          }
        },
        {
          "name": "Login (Campesino)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"pepe@finca.com\",\n  \"password\": \"123\"\n}" },
            "url": { "raw": "{{base_url}}/api/usuarios/login", "host": ["{{base_url}}"], "path": ["api", "usuarios", "login"] }
          }
        },
        {
          "name": "Login (Cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"maria@gmail.com\",\n  \"password\": \"123\"\n}" },
            "url": { "raw": "{{base_url}}/api/usuarios/login", "host": ["{{base_url}}"], "path": ["api", "usuarios", "login"] }
          }
        },
        {
          "name": "Verificar Email",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/usuarios/check-email?email=admin@agroconecta.com", "host": ["{{base_url}}"], "path": ["api", "usuarios", "check-email"], "query": [{ "key": "email", "value": "admin@agroconecta.com" }] }
          }
        }
      ]
    },
    {
      "name": "📦 Productos",
      "item": [
        {
          "name": "Listar todos los productos",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/productos", "host": ["{{base_url}}"], "path": ["api", "productos"] }
          }
        },
        {
          "name": "Obtener producto por ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/productos/1", "host": ["{{base_url}}"], "path": ["api", "productos", "1"] }
          }
        },
        {
          "name": "Productos de un campesino",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/productos/campesino/2", "host": ["{{base_url}}"], "path": ["api", "productos", "campesino", "2"] }
          }
        }
      ]
    },
    {
      "name": "🛒 Carrito",
      "item": [
        {
          "name": "Ver carrito",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/carrito", "host": ["{{base_url}}"], "path": ["api", "carrito"] }
          }
        },
        {
          "name": "Agregar producto al carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"id\": 1,\n  \"cantidad\": 3\n}" },
            "url": { "raw": "{{base_url}}/api/carrito/agregar", "host": ["{{base_url}}"], "path": ["api", "carrito", "agregar"] }
          }
        }
      ]
    },
    {
