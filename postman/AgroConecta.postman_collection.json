        },
        {
          "name": "Campesino acepta orden (completa flujo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/pedidos/orden/1/aceptar", "host": ["{{base_url}}"], "path": ["api", "pedidos", "orden", "1", "aceptar"] }
          }
        }
      ]
    },
